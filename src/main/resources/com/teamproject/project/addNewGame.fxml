<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="424.0" prefWidth="499.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teamproject.project.createGameController">
   <children>
      <Text layoutX="104.0" layoutY="47.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome to the game library">
         <font>
            <Font name="Calibri Bold" size="24.0" />
         </font>
      </Text>
      <Text layoutX="30.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Game Name: ">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="gameNameField" layoutX="133.0" layoutY="68.0" prefHeight="25.0" prefWidth="332.0" promptText="Enter the game's name (ex: Snakes and Ladders)" />
      <Text layoutX="22.0" layoutY="133.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Year Published:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="yearPublishedField" layoutX="25.0" layoutY="143.0" prefHeight="25.0" prefWidth="138.0" promptText="(ex: 2009)" />
      <Text layoutX="212.0" layoutY="133.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Minimum Player Count:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <Text layoutX="212.0" layoutY="173.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Maximum Player Count:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="minPlayersField" layoutX="380.0" layoutY="115.0" prefHeight="25.0" prefWidth="101.0" />
      <TextField fx:id="maxPlayersField" layoutX="380.0" layoutY="155.0" prefHeight="25.0" prefWidth="101.0" />
      <Text layoutX="15.0" layoutY="235.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Minutes Played:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="minutesPlayedField" layoutX="134.0" layoutY="216.0" prefHeight="25.0" prefWidth="101.0" />
      <Text layoutX="248.0" layoutY="235.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Game complexity:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="gameComplexityField" layoutX="377.0" layoutY="217.0" prefHeight="25.0" prefWidth="101.0" promptText="(ex: 3.4)" />
      <Text fill="#00000099" layoutX="367.0" layoutY="261.0" strokeType="OUTSIDE" strokeWidth="0.0" text="(1.0 = Easy, 5.0 = hard)" />
      <Text layoutX="25.0" layoutY="308.0" strokeType="OUTSIDE" strokeWidth="0.0" text="* Enter your name:">
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <TextField fx:id="userNameField" layoutX="25.0" layoutY="324.0" prefHeight="25.0" prefWidth="453.0" promptText="Enter your name (ex: John Doe)" />
      <Button layoutX="362.0" layoutY="376.0" mnemonicParsing="false" onAction="#registerGameAction" prefHeight="25.0" prefWidth="118.0" text="Add Game" />
      <Text fill="#00000099" layoutX="15.0" layoutY="184.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Enter nothing for current year" />
   </children>
</AnchorPane>
